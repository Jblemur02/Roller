{
  "_about": [
    "Gear rules. Every number in the gear system lives in this file.",
    "Tiers: packs roll a normal card tier, which converts to a gear tier via fromCardTiers.",
    "Item stats are for a Worn piece at level 1. Higher tiers multiply them by statMult and each level adds levelBonus (12%). Stats under 'fixed' never scale; 'minTier' means the item only has that stat from that gear tier up.",
    "Upgrade cost from level L to L+1 = round(levelCostBase * L^1.5 * tier levelCostMult) Chronos.",
    "Inner peace: each equipped item moves it by peace[relationship] depending on the item's side and yours, then fixed Inner peace bonuses add on. Final stats = (base + gear) x inner peace %, except Inner peace and AP rate.",
    "Base stats come from stats.json via baseFrom."
  ],
  "levelBonus": 0.12,
  "levelCostBase": 15,

  "stats": [
    { "key": "Health", "group": "Defense", "unit": "", "from": "resilience.health", "weight": 0.1, "about": "How much damage you can take." },
    { "key": "Armour", "group": "Defense", "unit": "%", "from": "resilience.armour", "weight": 4, "cap": 75, "about": "Cuts the damage you take by this %." },
    { "key": "Evasion", "group": "Defense", "unit": "%", "from": "evasion", "weight": 4, "cap": 60, "about": "Chance to dodge an attack completely." },
    { "key": "Lethal protection", "group": "Defense", "unit": "%", "from": "resilience.lethal_protection", "weight": 1, "cap": 90, "about": "Shrinks the extra damage of lethal hits against you." },
    { "key": "Damage", "group": "Offense", "unit": "", "from": "aggression.damage", "weight": 1, "about": "Base damage of your attacks." },
    { "key": "Perforation", "group": "Offense", "unit": "%", "from": "aggression.perforation", "weight": 3, "cap": 100, "about": "Ignores this much of the enemy's Armour %." },
    { "key": "Lethal chance", "group": "Offense", "unit": "%", "from": "aggression.lethal_chance", "weight": 4, "cap": 100, "about": "Chance for an attack to be a lethal hit." },
    { "key": "Lethal", "group": "Offense", "unit": "%", "from": "aggression.lethal", "weight": 0.5, "cap": 900, "about": "Extra damage on a lethal hit. 900% means 10x damage." },
    { "key": "Grip", "group": "Offense", "unit": "%", "from": "grip", "weight": 3, "cap": 100, "about": "Ignores this much of the enemy's Evasion %." },
    { "key": "Mana", "group": "Resources", "unit": "", "from": "mana", "weight": 0.3, "about": "Pays for spells." },
    { "key": "Energy", "group": "Resources", "unit": "", "from": "energy", "weight": 0.3, "about": "Pays for physical skills." },
    { "key": "AP rate", "group": "Resources", "unit": "", "from": "ap_rate", "weight": 60, "noPeace": true, "about": "Action points you get each round." },
    { "key": "Inner peace", "group": "Peace", "unit": "", "from": "inner_peace", "weight": 0, "min": 50, "max": 130, "noPeace": true, "about": "Your stats are multiplied by this %. Built by the gear you wear." }
  ],

